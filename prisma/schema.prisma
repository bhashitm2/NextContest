// CP Contest Portal — Prisma schema (v0.1 "The Wedge")
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Platform {
  CODEFORCES
  LEETCODE
  ATCODER
  CODECHEF
  HACKERRANK // reserved for a later release
  // v1.1 additions (append-only — never reorder a Postgres enum)
  GEEKSFORGEEKS
  CODE360
}

enum ContestStatus {
  UPCOMING
  ONGOING
  FINISHED
}

enum FriendStatus {
  PENDING
  ACCEPTED
}

// ---------------------------------------------------------------------------
// Auth.js (NextAuth v5) adapter models
// Standard @auth/prisma-adapter schema. Sessions kept for flexibility even
// though v0.1 uses the JWT session strategy.
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  // Secret token for the user's personal subscribable contest calendar feed
  // (GET /api/calendar/<token>.ics). Generated lazily on first subscribe.
  calendarToken String?   @unique
  // Public slug for the shareable profile page (GET /u/<username>). Set by the
  // user during profile setup; null until chosen.
  username      String?   @unique
  // IANA timezone (e.g. "Asia/Kolkata") captured from the browser, so reminder
  // emails (rendered server-side, in UTC) can show times in the user's zone.
  timezone      String?

  accounts Account[]
  sessions Session[]
  bookmarks Bookmark[]
  handles  PlatformHandle[]
  subscriptions PlatformSubscription[]
  tombstones CalendarTombstone[]
  sentRequests     Friendship[] @relation("SentRequests")
  receivedRequests Friendship[] @relation("ReceivedRequests")
  duelsSent     Duel[] @relation("DuelsSent")
  duelsReceived Duel[] @relation("DuelsReceived")
  judgeSubmissions JudgeSubmission[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Domain models
// ---------------------------------------------------------------------------

model Contest {
  id              String        @id @default(cuid())
  platform        Platform
  externalId      String // the platform's own contest identifier
  title           String
  url             String
  startTime       DateTime
  endTime         DateTime
  durationSeconds Int
  difficulty      String?
  status          ContestStatus @default(UPCOMING)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  bookmarks Bookmark[]
  tombstones CalendarTombstone[]

  @@unique([platform, externalId]) // dedupe key for upserts
  @@index([startTime])
  @@index([status, startTime])
}

model Bookmark {
  id            String    @id @default(cuid())
  userId        String
  contestId     String
  notify24h     Boolean   @default(true)
  notify1h      Boolean   @default(true)
  notified24hAt DateTime? // set once the 24h reminder is sent (idempotency)
  notified1hAt  DateTime? // set once the 1h reminder is sent (idempotency)
  auto          Boolean   @default(false) // created by a PlatformSubscription, not manually
  createdAt     DateTime  @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  contest Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)

  @@unique([userId, contestId])
  @@index([contestId])
}

// Records a contest a user UN-followed / un-bookmarked, so the calendar feed
// can keep emitting it as STATUS:CANCELLED until it ends. Subscribed calendar
// apps (especially Google) only remove an event when they see a cancellation,
// not when it silently disappears from the feed. Pruned once the contest ends.
model CalendarTombstone {
  id        String   @id @default(cuid())
  userId    String
  contestId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  contest Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)

  @@unique([userId, contestId])
  @@index([contestId])
}

// "Follow a platform": auto-reminders for every upcoming contest on it, no
// manual bookmarking. Drives auto-created Bookmarks (see server/sync/auto-bookmarks).
model PlatformSubscription {
  id        String   @id @default(cuid())
  userId    String
  platform  Platform
  notify24h Boolean  @default(true)
  notify1h  Boolean  @default(true)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform])
}

// v0.5 (handle connect + Codolio-style verification + cross-platform stats).
model PlatformHandle {
  id               String    @id @default(cuid())
  userId           String
  platform         Platform
  handle           String
  rating           Int? // current rating
  maxRating        Int? // peak rating
  rank             String? // platform title, e.g. "Expert", "5★", "Cyan"
  problemsSolved   Int? // headline count (cheap cross-platform aggregation)
  // Rich payload: { difficulty:{easy,medium,hard}, contests, recentSolved:[…],
  // solvedByMonth:[{month,count}], … }. Shape = ProfileStats.extra.
  stats            Json?
  verified         Boolean   @default(false)
  verificationCode String?
  // Compile-error verification (alternative to the bio-token method): the pinned
  // challenge problem key (CF "4-A" / AtCoder "abc086_a") + when it was issued.
  verifyProblem    String?
  verifyStartedAt  DateTime?
  lastSynced       DateTime?
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform])
}

// v0.6 social layer. One row per ordered (requester→addressee) pair; a PENDING
// row is a friend request, ACCEPTED is a friendship. "Friends of X" = ACCEPTED
// rows where X is requester OR addressee.
model Friendship {
  id          String       @id @default(cuid())
  requesterId String
  addresseeId String
  status      FriendStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  respondedAt DateTime?

  requester User @relation("SentRequests", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("ReceivedRequests", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@index([requesterId, status])
}

// v1.7 Problem Duels. Challenge a friend to solve N unsolved-by-both problems
// in a time window (Codeforces-only v1). One row per duel; the problem set +
// per-player solve timestamps live in `problems` Json (written once at accept,
// always read as a whole set, N ≤ 7 — separate rows would only add joins).
// Handles are FROZEN onto the row at accept so removing/unverifying a handle
// mid-duel can't break judging. Cancel deletes the PENDING row (no CANCELLED).
enum DuelStatus {
  PENDING // invite sent, opponent hasn't responded
  ACTIVE // accepted; clock running
  FINISHED
  DECLINED
  EXPIRED // invite older than 24h, marked lazily
}

enum DuelFormat {
  TIMED // most solves when the clock ends (tie → lower penalty → draw)
  FIRST_SOLVE // first AC on any duel problem wins immediately
  RACE // first to solve ALL problems wins (may end early)
}

model Duel {
  id           String     @id @default(cuid())
  platform     Platform   @default(CODEFORCES)
  challengerId String
  opponentId   String
  status       DuelStatus @default(PENDING)
  format       DuelFormat
  problemCount Int // from preset: 3 | 5 | 7
  durationSec  Int // from preset: 1800 | 3600 | 7200
  winTarget    Int? // null=TIMED, 1=FIRST_SOLVE, =problemCount for RACE
  ratingMin    Int
  ratingMax    Int

  challengerHandle String? // frozen at accept
  opponentHandle   String?
  problems         Json? // DuelProblem[] — set at accept (see server/duel)

  startedAt     DateTime?
  endsAt        DateTime?
  finishedAt    DateTime?
  winnerId      String? // null while running or on a draw
  draw          Boolean   @default(false)
  lastCheckedAt DateTime? // judging throttle + stampede guard
  createdAt     DateTime  @default(now())
  respondedAt   DateTime?

  challenger User @relation("DuelsSent", fields: [challengerId], references: [id], onDelete: Cascade)
  opponent   User @relation("DuelsReceived", fields: [opponentId], references: [id], onDelete: Cascade)

  @@index([challengerId, status])
  @@index([opponentId, status])
}

// v1.8 NextContest Judge — Practice. Own problem bank + own execution
// (nc-judge microservice on the Oracle VM). Problems are AI-drafted, validated
// (the reference solution must AC through the real judge) and human-reviewed:
// DRAFT rows are visible/publishable only by the admin. Samples are the
// hidden=false tests; hidden test data never leaves the server. A future
// in-house duel references Problem rows and detects solves from
// JudgeSubmission (judging is synchronous → instant, no polling).
enum ProblemStatus {
  DRAFT
  PUBLISHED
}

enum JudgeLanguage {
  PYTHON
  CPP
  JAVA
}

enum JudgeVerdict {
  AC // accepted
  WA // wrong answer
  TLE // time limit exceeded
  MLE // memory limit exceeded (container OOM-kill)
  RE // runtime error
  CE // compile error
  JUDGE_ERROR // judge reachable but failed internally (kept for diagnostics)
}

model Problem {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       String
  statementMd String        @db.Text
  editorialMd String?       @db.Text // shown under the Editorial tab (spoiler-gated in the UI)
  difficulty  Int // CF-style 800–2400
  tags        String[]
  timeLimitMs Int           @default(2000)
  memoryMb    Int           @default(256)
  status      ProblemStatus @default(DRAFT)
  ord         Int           @default(0) // curated list order (difficulty tiebreak)
  createdAt   DateTime      @default(now())

  tests       ProblemTest[]
  submissions JudgeSubmission[]

  @@index([status, difficulty])
}

model ProblemTest {
  id        String  @id @default(cuid())
  problemId String
  ord       Int
  input     String  @db.Text
  expected  String  @db.Text
  hidden    Boolean @default(true) // hidden=false ⇒ sample shown in the statement

  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([problemId, ord])
}

model JudgeSubmission {
  id            String        @id @default(cuid())
  userId        String
  problemId     String
  language      JudgeLanguage
  source        String        @db.Text
  verdict       JudgeVerdict
  passedCount   Int
  totalCount    Int
  timeMs        Int?
  compileOutput String?       @db.Text
  createdAt     DateTime      @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@index([userId, problemId, createdAt])
  @@index([problemId, verdict])
}

// v0.6 Phase 3. Caches the AI-written head-to-head verdict for a pair of users.
// `pairKey` = the two user ids sorted + joined (direction-independent, so both
// viewers share one cache). Regenerated only when `statsHash` changes or the row
// is >24h old, to respect the Gemini free-tier rate limit.
model ComparisonVerdict {
  id        String   @id @default(cuid())
  pairKey   String   @unique
  statsHash String
  verdict   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// v1.0 per-contest compare. Caches one user's finalized performance (rank +
// rating change) on a single rated contest. Results are IMMUTABLE once a
// contest is rated, so a row never needs refreshing — keyed by handle (not
// userId) so the cache is reusable across the viewer/friend roles and survives
// handle changes. Only successful ("ok") fetches are cached; the pending /
// not-participated / unavailable states are transient and re-checked each view.
model ContestResult {
  id             String   @id @default(cuid())
  platform       Platform
  externalId     String // matches Contest.externalId
  handle         String // lowercased platform handle
  rank           Int?
  ratingBefore   Int?
  ratingAfter    Int?
  ratingDelta    Int?
  problemsSolved Int?
  performance    Int?
  fetchedAt      DateTime @default(now())

  @@unique([platform, externalId, handle])
  @@index([platform, externalId])
}

// Rating Predictor (Codeforces + LeetCode). Caches one handle's PREDICTED rating
// change on a single contest, computed in the window between the contest ending
// and the platform officially applying ratings (the Carrot / LeetCode-predictor
// use case). Keyed by handle (not userId) so it's reusable across the personal
// page and the public lookup tool, and survives handle changes — mirroring
// ContestResult. A whole CF contest is computed at once (rating change depends on
// everyone's seed), so many rows share one (platform, externalId).
//   state: "live"  → predicted from current ratings, not yet official
//          "final" → contest is now officially rated; delta is the real one
//          "pending" / "unavailable" are transient and not normally persisted.
model RatingPrediction {
  id             String   @id @default(cuid())
  platform       Platform
  externalId     String // matches Contest.externalId
  handle         String // lowercased platform handle
  rank           Int?
  predictedDelta Int?
  currentRating  Int? // rating going IN to the contest
  performance    Int? // CF: the rating at which the delta would be zero
  state          String   @default("live")
  modelVersion   String   @default("v1")
  computedAt     DateTime @default(now())

  @@unique([platform, externalId, handle])
  @@index([platform, externalId])
}

// One row per contest we've run the predictor on, so the cron can skip recompute
// and we don't re-fetch a 30k-row standings + the multi-MB rated-user list on
// every view. `rated` flips true once the platform has officially rated it.
model PredictionRun {
  platform         Platform
  externalId       String
  participantCount Int?
  rated            Boolean  @default(false)
  ok               Boolean  @default(true)
  computedAt       DateTime @default(now())

  @@id([platform, externalId])
}

// Tracks per-source pipeline health so the UI can show a "stale data" banner
// and the founder can be alerted on scraper failure.
model SyncState {
  source           Platform  @id
  lastRunAt        DateTime?
  lastSuccessAt    DateTime?
  lastError        String?
  contestsUpserted Int       @default(0)
  updatedAt        DateTime  @updatedAt
}
